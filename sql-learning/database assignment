-- All players who have spent more than 7500 in total

SELECT pl.player_id, pl.player_name, pl.player_username, SUM(p.price) AS total_spent
FROM player pl, purchase pur, purchase_line_item p
WHERE pl.player_id = pur.player_id AND p.purchase_id = pur.purchase_id
GROUP BY pl.player_id
HAVING SUM(p.price) > 7500;


-- Count purchases, not purchase_line_items and add 10 points for each
-- Default value for loyalty_points is 0, so if there was no purchase made, 0 will be written

ALTER TABLE player ADD COLUMN loyalty_points INTEGER DEFAULT 0;
UPDATE player p
SET loyalty_points = 10 * (
    SELECT COUNT(*)
    FROM purchase pur
    WHERE pur.player_id = p.player_id
);


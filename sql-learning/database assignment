-- Insert into genre table

INSERT INTO genre (genre_name)
SELECT DISTINCT genre
FROM games.games
WHERE genre IS NOT NULL;

-- Insert into player table, while converting TEXT type dateofbirth to DATE type date_of_birth

INSERT INTO player
    (player_id, player_name, player_username, date_of_birth, country, favorite_genre_id)
SELECT DISTINCT
    p.playerid,
    p.playername,
    p.playerusername,
    NULLIF(p.dateofbirth, '')::DATE,
    p.country,
    g.genre_id
FROM games.players p
JOIN genre AS g
    ON g.genre_name = p.favoritegenre;

-- Insert into contact_information table

INSERT INTO contact_information
    (player_email, phone, player_id)
SELECT DISTINCT
    email,
    phone,
    playerid
FROM games.players;

-- Insert into studio table

INSERT INTO studio
    (studio_name, studio_country, studio_email)
SELECT DISTINCT
    developername,
    developercountry,
    developeremail
FROM games.games
WHERE developername IS NOT NULL;

-- Insert into platform table

INSERT INTO platform (platform_name)
SELECT DISTINCT platform
FROM games.games
WHERE platform IS NOT NULL;

-- Insert into store table

INSERT INTO store (store_name, store_city)
SELECT DISTINCT
    storename,
    storecity
FROM games.purchases
WHERE storename IS NOT NULL;

-- Insert into game table

INSERT INTO game
    (game_id, title, release_year,  game_price, rating,
     platform_id, genre_id, studio_name)
SELECT
    g.gameid,
    g.gametitle,
    g.releaseyear,
    g.price,
    g.rating,
    p.platform_id,
    ge.genre_id,
    g.developername
FROM games.games AS g
JOIN platform AS p
    ON p.platform_name = g.platform
JOIN genre AS ge
    ON ge.genre_name = g.genre;

-- Insert into purchase table, while converting TEXT type purchasedate to DATE type purchase_date

INSERT INTO purchase
    (purchase_id, purchase_date, payment_method, player_id, store_id)
SELECT DISTINCT
    src.saleid,
    NULLIF(src.purchasedate, '')::DATE,
    src.paymentmethod,
    pl.player_id,
    st.store_id
FROM games.purchases AS src
JOIN player AS pl
    ON pl.player_username = src.playerusername
JOIN store AS st
    ON st.store_name = src.storename
   AND st.store_city = src.storecity;

-- Insert into purchase_line_item table, while connecting three initial tables on name and id

INSERT INTO purchase_line_item
    (quantity, price, purchase_id, game_id)
SELECT
    src.quantity,
    src.totalprice,
    src.saleid,
    g.game_id
FROM games.purchases AS src
JOIN game AS g
    ON g.title = src.gametitle
   AND g.studio_name = src.developername
JOIN platform AS p
    ON p.platform_id = g.platform_id
   AND p.platform_name = src.gameplatform
JOIN genre AS ge
    ON ge.genre_id = g.genre_id
   AND ge.genre_name = src.gamegenre;


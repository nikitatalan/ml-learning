-- Assignment 2/3: CREATE TABLE --
----------------------------------

-- We used SERIAL data type for the new IDs for which we didn't have corresponding columns in the old tables.
-- Basically, SERIAL generates number starting from 1 that we then use as the IDs.


CREATE TABLE genre(
    genre_id SERIAL PRIMARY KEY, 
    genre_name TEXT NOT NULL UNIQUE
);

CREATE TABLE platform(
    platform_id SERIAL PRIMARY KEY, 
    platform_name TEXT NOT NULL UNIQUE
);

CREATE TABLE studio(
    studio_name TEXT PRIMARY KEY,
    studio_country TEXT NOT NULL,
    studio_email TEXT NOT NULL
);

CREATE TABLE store(
    store_id SERIAL PRIMARY KEY, 
    store_name TEXT NOT NULL UNIQUE,
    store_city TEXT
);

CREATE TABLE player(
    player_id INTEGER PRIMARY KEY, 
    player_name TEXT NOT NULL,
    player_username TEXT NOT NULL UNIQUE,
    date_of_birth DATE,
    country TEXT,
    favorite_genre_id INTEGER NOT NULL,
        FOREIGN KEY (favorite_genre_id) REFERENCES genre (genre_id)
);

CREATE TABLE contact_information(
    player_email TEXT PRIMARY KEY,
    phone TEXT,
    player_id INTEGER NOT NULL UNIQUE,
        FOREIGN KEY (player_id) REFERENCES player (player_id)
);

CREATE TABLE game(
    game_id INTEGER PRIMARY KEY, 
    title TEXT NOT NULL,
    release_year INTEGER,
    game_price DOUBLE PRECISION,
    rating DOUBLE PRECISION,
    platform_id INTEGER NOT NULL,
        FOREIGN KEY (platform_id) REFERENCES platform (platform_id),
    genre_id INTEGER NOT NULL,
        FOREIGN KEY (genre_id) REFERENCES genre (genre_id),
    studio_name TEXT NOT NULL,
        FOREIGN KEY (studio_name) REFERENCES studio (studio_name)
);

CREATE TABLE purchase(
    purchase_id INTEGER PRIMARY KEY, 
    purchase_date DATE,
    payment_method TEXT,
    player_id INTEGER NOT NULL,
        FOREIGN KEY (player_id) REFERENCES player (player_id),
    store_id INTEGER NOT NULL,
        FOREIGN KEY (store_id) REFERENCES store (store_id)
);

-- Price corresponds to the total price of the line

CREATE TABLE purchase_line_item(
    item_id SERIAL PRIMARY KEY, 
    quantity INTEGER,
    price DOUBLE PRECISION,
    purchase_id INTEGER NOT NULL,
        FOREIGN KEY (purchase_id) REFERENCES purchase (purchase_id),
    game_id INTEGER NOT NULL,
        FOREIGN KEY (game_id) REFERENCES game (game_id)
);

